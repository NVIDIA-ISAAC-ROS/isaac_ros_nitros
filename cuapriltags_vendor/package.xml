<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuapriltags_vendor</name>
  <version>5.0.0</version>
  <description>Vendor package for the precompiled NVIDIA cuAprilTags SDK.</description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>NVIDIA Isaac ROS Software License</license>
  <url type="website">https://developer.nvidia.com/isaac-ros-gems/</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend condition="$ISAAC_ROS_PLATFORM != arm64-fastos">cuda-toolkit-13-2</depend>
  <depend condition="$ISAAC_ROS_PLATFORM == arm64-fastos">cuda-toolkit-13-0</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
